name: URL Shortener Generator
on:
  push:
    paths:
      - 'links.yml'
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - name: Generate Redirects
        run: |
          # Read links.yml and create folders
          while IFS= read -r line; do
            if [[ $line == *"short:"* ]]; then
              SHORT=$(echo $line | awk '{print $2}')
            elif [[ $line == *"long:"* ]]; then
              LONG=$(echo $line | awk '{print $2}')
              mkdir -p $SHORT
              echo "<!DOCTYPE html><html><head><meta http-equiv=\"refresh\" content=\"0; url=$LONG\"></head></html>" > $SHORT/index.html
            fi
          done < links.yml
      - name: Deploy to GitHub Pages
        uses: JamesIves/github-pages-deploy-action@v4
        with:
          folder: .
          branch: gh-pages # This pushes the generated folders to your live site
